# Convex environment variables.
# Set these on the deployment with `npx convex env set NAME value`; they are not read from this file.
# The three PIPES_* secrets are only needed beyond the demo (real numbers, real webhooks, sending).
PIPES_API_KEY=ak_replace_me
PIPES_APP_SLUG=your-app-slug
PIPES_WEBHOOK_SECRET=whsec_replace_me
# Optional, defaults to https://api.pipes.bot
PIPES_API_BASE_URL=https://api.pipes.bot
# Where the web app is served, e.g. http://localhost:5173
SITE_URL=http://localhost:5173
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# Vite environment variables (written to .env.local by `npx convex dev`).
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

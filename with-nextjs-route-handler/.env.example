# pk_... = sandbox, ak_... = BYON API v2. The prefix selects the mode.
PIPES_API_KEY=ak_your_api_key

# Sandbox: the webhook secret you configured (optional, skips verification if empty).
# BYON v2: the whsec_... signing secret of your App (required).
PIPES_WEBHOOK_SECRET=whsec_your_secret

# Optional. Defaults to https://api.pipes.bot (point it at the mock API for local tests).
# PIPES_API_BASE_URL=https://api.pipes.bot
